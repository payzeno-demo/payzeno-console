# payzeno-console — the seven build-time variables. That is the whole list.
# boot. A missing required var throws EnvConfigError from main.tsx before the first render —
# --- feature flags (build-time; src/lib/flags.ts is the only reader) ---
VITE_FEATURE_SETTLEMENT_EXPLORER=true
VITE_FEATURE_DISPUTE_EVIDENCE_V2=false
