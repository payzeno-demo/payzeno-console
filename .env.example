# payzeno-console — the seven build-time variables. That is the whole list.
#
# These are baked into the bundle by Vite at BUILD time. They are not secrets and they are
# not runtime configuration: changing one means a rebuild, not a restart. If you are
# reaching for an eighth variable, that is a conversation, not a PR (ADR 0002).
#
# Every name below resolves to a field on `Env` in src/config/env.ts and is zod-validated at
# boot. A missing required var throws EnvConfigError from main.tsx before the first render —
# a console that boots without an API URL and shows an empty dashboard is worse than one
# that refuses to start.

# Base URL of payzeno-api, including the /v1 prefix. Through payzeno-nginx in compose.
VITE_PAYZENO_API_URL=http://localhost/v1

# payzeno-api's notification gateway. Session cookie + CSRF ride the upgrade request.
VITE_WS_URL=ws://localhost/ws/notifications

# The card vault's PUBLIC surface. The browser posts card data straight here and gets a
# pmt_... token back; card data never transits payzeno-api. See ADR 0003.
VITE_VAULT_PUBLIC_URL=http://localhost:8099/public

# Empty disables Sentry entirely (the default for local dev).
VITE_SENTRY_DSN=

# local | qa | staging | production. Drives <EnvironmentBanner /> and the Sentry environment.
VITE_ENVIRONMENT=local

# --- feature flags (build-time; src/lib/flags.ts is the only reader) ---
# Settlements UI. Defaulted on since PAY-1702.
VITE_FEATURE_SETTLEMENT_EXPLORER=true
# New dispute evidence form. Off everywhere except qa.
VITE_FEATURE_DISPUTE_EVIDENCE_V2=false
