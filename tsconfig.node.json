{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    // A referenced (composite) project may not set noEmit (TS6310). Nothing consumes these
    // declarations; they only exist so the reference is legal. node_modules/ is gitignored.
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.tmp/tsconfig.node",
    "types": ["node"]
  },
  "include": ["vite.config.ts", "vitest.config.ts", "scripts/**/*.mjs"]
}
